{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "votesites",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "event.ymkw.top",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "VOTES_DB",
      "database_name": "votesites-db",
      "database_id": "7c07d1fe-f367-411b-a442-41248d9fbca9",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
