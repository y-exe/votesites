{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.open-next",
      "!**/.wrangler",
      "!**/.turbo",
      "!**/dist",
      "!**/out",
      "!**/public",
      "!**/cloudflare-env.d.ts",
      "!**/next-env.d.ts",
      "!**/*lock*",
      "!**/src/data"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnreachable": "error",
        "noInvalidConstructorSuper": "error",
        "noInvalidBuiltinInstantiation": "error"
      },
      "suspicious": {
        "noDebugger": "error",
        "noDuplicateParameters": "error",
        "noDuplicateCase": "error"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
